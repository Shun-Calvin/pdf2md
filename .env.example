# PDF2MD Converter Environment Configuration
# Copy this file to .env and customize the values

# ============================================
# App Settings
# ============================================
DEBUG=false
APP_NAME=PDF2MD Converter

# ============================================
# Server Settings
# ============================================
HOST=0.0.0.0
PORT=8000

# ============================================
# Storage Settings
# ============================================
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
TEMP_DIR=temp

# ============================================
# Database
# ============================================
# SQLite (default for development)
DATABASE_URL=sqlite:///./pdf2md.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/pdf2md

# ============================================
# Redis (for task queue)
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# OCR Settings
# ============================================
# Available engines: paddleocr_mobile, paddleocr_server, tesseract, cloud, docling
DEFAULT_OCR_ENGINE=paddleocr_mobile

# Tesseract path (optional, auto-detected if not set)
# TESSERACT_CMD=/usr/bin/tesseract

# PaddleOCR GPU support
PADDLEOCR_USE_GPU=false

# ============================================
# Docling Settings (optional)
# ============================================
# Enable Docling for advanced document parsing
USE_DOCLING=false

# Docling OCR Engine: tesseract, easyocr
DOCLING_OCR_ENGINE=tesseract

# Docling Features
DOCLING_ENABLE_TABLE_DETECTION=true
DOCLING_ENABLE_FIGURE_DETECTION=true
DOCLING_ENABLE_LAYOUT_ANALYSIS=true

# ============================================
# Open Data Loader Settings (optional)
# ============================================
# Enable Open Data Loader for batch processing
USE_OPEN_DATA_LOADER=false

# Batch processing settings
ODL_BATCH_SIZE=4
ODL_NUM_WORKERS=2
ODL_ENABLE_STREAMING=false

# ============================================
# Cloud OCR Settings (optional)
# ============================================
# Provider: aws, azure, google
# CLOUD_OCR_PROVIDER=aws
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1

# ============================================
# Image Description Settings (optional)
# ============================================
ENABLE_IMAGE_DESCRIPTION=false
IMAGE_DESCRIPTION_PROVIDER=openai

# OpenAI Settings
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4-vision-preview

# OpenAI Compatible Provider (e.g., local LLM)
# OPENAI_COMPATIBLE_API_KEY=your_api_key
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
# OPENAI_COMPATIBLE_MODEL=llava

# ============================================
# Image Processing
# ============================================
ENABLE_IMAGE_DEDUPLICATION=false
IMAGE_DEDUP_THRESHOLD=0.9
IMAGE_DEDUP_HASH_SIZE=16

# ============================================
# Processing Settings
# ============================================
MAX_WORKERS=4
BATCH_SIZE=10
